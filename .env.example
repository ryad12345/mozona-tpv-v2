# ============================================================
# MOZONA TPV — variables de entorno (PLANTILLA)
# ============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA commitees el `.env` con claves reales a Git.

# --- Supabase Cloud ---------------------------------------------
# URL de tu proyecto Supabase (sin barra final)
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Anon key (pública — puede ir al frontend)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service role key (SECRETA — sólo en Edge Functions / backend)
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Email del superadmin (bypass de paywall + panel /admin/invites)
VITE_SUPERADMIN_EMAIL=rofixinsta@gmail.com

# --- Stripe (opcional) ------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PRICE_PLUS=price_plus_30
VITE_STRIPE_PRICE_PRO=price_pro_50

# --- Servidor LAN (caja central) --------------------------------
MOZONA_LAN_PORT=7421
LAN_API_KEY=mozona-dev-key

# --- Logging (Tauri) --------------------------------------------
RUST_LOG=info,mozona_tpv_lib=debug
